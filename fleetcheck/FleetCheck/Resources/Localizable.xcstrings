        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez ou dictez (touchez le micro du clavier). Avec Apple Intelligence, vous pouvez demander avec vos mots, en français, en anglais ou en roumain. Chaque chiffre vient de vos propres données sur cet iPhone."
          }
        },
        "ro" : {
