        }
      }
    },
    "Take a screenshot of a trip, a day or a week in Uber or Bolt. DriveCap reads the money, kilometers and destination for you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une capture d’une course, d’une journée ou d’une semaine dans Uber ou Bolt. DriveCap lit pour vous l’argent, les kilomètres et la destination."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fă o captură a unei curse, a unei zile sau a unei săptămâni în Uber sau Bolt. DriveCap citește pentru tine banii, kilometrii și destinația."
          }
        }
      }
    },
    "Take a screenshot of the trip or earnings screen in Uber or Bolt, then pick it here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
