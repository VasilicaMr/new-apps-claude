        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încarcă-ți câștigurile din Uber și Bolt, adaugă cheltuielile, iar DriveCap îți arată cât îți rămâne pe oră și pe km. Trei pași, mai ales capturi."
          }
