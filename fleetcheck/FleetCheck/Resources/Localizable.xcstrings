    "Home shows what you keep this week. Ask anything in your own words; every number comes from your own data." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accueil montre ce qu’il vous reste cette semaine. Posez vos questions avec vos mots ; chaque chiffre vient de vos propres données."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acasă vezi cât îți rămâne săptămâna asta. Întreabă orice, cu cuvintele tale; fiecare cifră vine din datele tale."
          }
        }
      }
