    "You get a notification 30, 7 and 1 days before each date. Swipe right to mark a repeating item as done." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevez une notification 30, 7 et 1 jour avant chaque date. Balayez vers la droite pour marquer un élément récurrent comme fait."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primești o notificare cu 30, 7 și 1 zi înainte de fiecare dată. Glisează la dreapta ca să marchezi ca făcut un element care se repetă."
          }
        }
      }
    },
    "You have DriveCap Pro. Everything is unlocked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
