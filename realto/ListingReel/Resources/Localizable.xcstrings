    "Added to your exported video. Narration longer than the video is cut off at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird deinem exportierten Video hinzugefügt. Ist der Sprechertext länger als das Video, wird er am Ende abgeschnitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added to your exported video. Narration longer than the video is cut off at the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade a tu vídeo exportado. Si la narración dura más que el vídeo, se corta al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutée à votre vidéo exportée. Si la narration est plus longue que la vidéo, elle est coupée à la fin."
          }
        },
        "it" : {
